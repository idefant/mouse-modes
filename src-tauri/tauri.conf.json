{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouse Modes",
  "version": "0.1.3",
  "identifier": "dev.mouse-modes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mouse Modes",
        "width": 760,
        "height": 810,
        "minWidth": 393,
        "minHeight": 300,
        "backgroundColor": "#151719"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "systemd",
          "acl",
          "kmod",
          "libsystemd0",
          "udev"
        ],
        "files": {
          "/usr/lib/systemd/system/mouse-modes-input.socket": "linux/mouse-modes-input.socket",
          "/usr/lib/systemd/system/mouse-modes-input@.service": "linux/mouse-modes-input@.service",
          "/usr/lib/sysusers.d/mouse-modes.conf": "linux/sysusers.conf",
          "/usr/lib/modules-load.d/mouse-modes.conf": "linux/modules-load.conf",
          "/usr/lib/udev/rules.d/70-mouse-modes.rules": "linux/70-mouse-modes.rules"
        },
        "postInstallScript": "linux/post-install.sh",
        "preRemoveScript": "linux/pre-remove.sh",
        "postRemoveScript": "linux/post-remove.sh"
      },
      "rpm": {
        "depends": [
          "systemd",
          "acl",
          "kmod",
          "systemd-libs",
          "systemd-udev"
        ],
        "files": {
          "/usr/lib/systemd/system/mouse-modes-input.socket": "linux/mouse-modes-input.socket",
          "/usr/lib/systemd/system/mouse-modes-input@.service": "linux/mouse-modes-input@.service",
          "/usr/lib/sysusers.d/mouse-modes.conf": "linux/sysusers.conf",
          "/usr/lib/modules-load.d/mouse-modes.conf": "linux/modules-load.conf",
          "/usr/lib/udev/rules.d/70-mouse-modes.rules": "linux/70-mouse-modes.rules"
        },
        "postInstallScript": "linux/post-install.sh",
        "preRemoveScript": "linux/pre-remove.sh",
        "postRemoveScript": "linux/post-remove.sh"
      }
    }
  }
}
